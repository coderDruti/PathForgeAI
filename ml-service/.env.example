# ML & Gen AI Microservice Configuration
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# Embedding backend: "sentence_transformers" (all-MiniLM-L6-v2), "gemini" (API, low RAM), or "tfidf_svd" (offline)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
# Semantic cosine normalization: "zscore_sigmoid" | "minmax" | "linear"
SEMANTIC_NORM_MODE=zscore_sigmoid

# LLM Provider for RAG Roadmap Synthesis: "gemini" | "openai" | "fallback"
LLM_PROVIDER=gemini

# Google Gemini (default cloud provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# OpenAI (alternative cloud provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
