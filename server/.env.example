PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (local MongoDB, Docker Compose, or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/career_recommender

# Set to true for zero-setup local development when mongod/Docker is not installed
USE_INMEMORY_MONGO=false

# JWT signing secret (change in production!)
JWT_SECRET=dev-super-secret-change-me-in-production-32chars
JWT_EXPIRES_IN=7d

# Python ML & Gen AI Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=45000
